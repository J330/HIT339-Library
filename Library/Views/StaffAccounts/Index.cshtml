@model IReadOnlyList<S379658_HIT339_Assignment2_Library.ViewModels.StaffAccountListViewModel>
@{ ViewData["Title"] = "Staff Account Management"; }
<div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Staff Account Management</h1>
        <p class="text-muted mb-0">Administrator-only staff directory, account creation and password resets.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Create staff account</a>
</div>
@if (TempData["StaffAccountCreated"] is string confirmation)
{
    <div class="alert alert-success" role="status">@confirmation</div>
}
@if (TempData["StaffPasswordReset"] is string resetConfirmation)
{
    <div class="alert alert-success" role="status">@resetConfirmation</div>
}
@if (TempData["StaffPasswordError"] is string passwordError)
{
    <div class="alert alert-warning" role="alert">@passwordError</div>
}
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead><tr><th>Full name</th><th>Username</th><th>Email</th><th>Role</th><th>First sign-in</th><th>Actions</th></tr></thead>
        <tbody>
        @foreach (var staff in Model)
        {
            <tr>
                <td>@staff.FullName</td>
                <td>@staff.Username</td>
                <td>@staff.Email</td>
                <td>@staff.Roles</td>
                <td>@(staff.MustChangePassword ? "Password change required" : "Ready")</td>
                <td>
                    @if (staff.UserId.ToString() != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                    {
                        <a asp-controller="StaffAccounts" asp-action="ResetPassword" asp-route-id="@staff.UserId"
                           class="btn btn-outline-secondary btn-sm" aria-label="Reset password for @staff.Username">Reset password</a>
                    }
                    else
                    {
                        <span class="text-muted small">Current account</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
    @if (Model.Count == 0)
    {
        <p class="text-muted">No staff accounts have been created yet.</p>
    }
</div>
<p class="text-muted small">This page does not display passwords. Staff must change administrator-issued temporary passwords when they first sign in.</p>
