@model S379658_HIT339_Assignment2_Library.ViewModels.ResetStaffPasswordViewModel
@{ ViewData["Title"] = "Reset Staff Password"; }
<div class="row justify-content-center py-3">
    <div class="col-lg-8 col-xl-7">
        <h1>Reset staff password</h1>
        <p class="text-muted">Only an administrator can issue a replacement temporary password.</p>
        <div class="alert alert-warning" role="note">
            You are resetting <strong>@Model.StaffUsername</strong>
            @if (!string.IsNullOrWhiteSpace(Model.StaffFullName))
            {
                <span>(@Model.StaffFullName)</span>
            }
            . This member will need to change the temporary password when they next sign in.
        </div>
        <form asp-controller="StaffAccounts" asp-action="ResetPassword" method="post" asp-antiforgery="true" class="card shadow-sm">
            <input asp-for="UserId" type="hidden" />
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="NewTemporaryPassword" class="form-label"></label>
                    <input asp-for="NewTemporaryPassword" class="form-control" autocomplete="new-password" />
                    <div class="form-text">At least 12 characters, with uppercase and lowercase letters, a number and a symbol.</div>
                    <span asp-validation-for="NewTemporaryPassword" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmTemporaryPassword" class="form-label"></label>
                    <input asp-for="ConfirmTemporaryPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmTemporaryPassword" class="text-danger"></span>
                </div>
                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button class="btn btn-primary" type="submit">Save temporary password</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </form>
        <p class="text-muted small mt-3">Give the new password to the staff member through a secure channel. Existing passwords cannot be viewed.</p>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
