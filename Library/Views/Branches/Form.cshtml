@model LibraryBranch
@{ ViewData["Title"] = Model.Id == 0 ? "Add branch" : "Edit branch"; }
<h1>@ViewData["Title"]</h1>
<form asp-action="Save" method="post" class="col-md-7">
  <input type="hidden" asp-for="Id" />
  <div asp-validation-summary="All" class="text-danger"></div>
  <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
  <div class="mb-3"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" /></div>
  <div class="mb-3"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /></div>
  <div class="mb-3"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /></div>
  <div class="mb-3"><label asp-for="OpeningHours" class="form-label"></label><input asp-for="OpeningHours" class="form-control" placeholder="Mon–Fri 09:00–17:00" /></div>
  <div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
  <button class="btn btn-primary">Save branch</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
