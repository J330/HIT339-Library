@model IReadOnlyList<S379658_HIT339_Assignment2_Library.ViewModels.FinePaymentRow>
@{
    ViewData["Title"] = "Fine Payments";
}
<h1>Fine payment receipts</h1>
<p class="text-muted">Fines charged are kept separately from actual receipts. Only record a receipt once payment has been received. A payment cannot exceed the remaining balance.</p>
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-warning">@error</div> }
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
<div class="table-responsive">
<table class="table table-striped table-bordered align-middle">
<thead><tr><th>Borrowing #</th><th>Borrower</th><th>Item</th><th>Charged</th><th>Paid</th><th>Outstanding</th><th>Record payment</th></tr></thead>
<tbody>
@foreach (var row in Model)
{
    <tr>
        <td>@row.BorrowingId</td><td>@row.Borrower</td><td>@row.Item</td>
        <td>@row.Charged.ToString("C")</td><td>@row.Paid.ToString("C")</td><td>@row.Outstanding.ToString("C")</td>
        <td>
            @if (row.Outstanding > 0)
            {
                <form asp-action="Record" method="post" class="d-flex flex-wrap gap-2 align-items-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="BorrowingId" value="@row.BorrowingId" />
                    <input type="number" name="Amount" min="0.01" step="0.01" max="@row.Outstanding.ToString(System.Globalization.CultureInfo.InvariantCulture)" placeholder="Amount" class="form-control" style="max-width: 100px" required />
                    <input type="text" name="Reference" maxlength="100" placeholder="Receipt/reference" class="form-control" style="max-width: 180px" required />
                    <button class="btn btn-sm btn-primary" type="submit">Record</button>
                </form>
            }
            else { <span class="text-success">Paid in full</span> }
        </td>
    </tr>
}
</tbody>
</table>
</div>
@if (Model.Count == 0) { <p>No charged fines yet.</p> }
