@model S379658_HIT339_Assignment2_Library.ViewModels.BorrowerViewModel
@{ ViewData["Title"] = "My contact details"; }
<div class="row justify-content-center py-3"><div class="col-lg-8 col-xl-7">
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3">
        <div><h1>My contact details</h1><p class="text-muted mb-0">Update the details stored in your library account.</p></div>
        <a asp-controller="Kiosk" asp-action="Account" class="btn btn-outline-primary">Back to my account</a>
    </div>
    @if (TempData["ProfileSaved"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    <div class="alert alert-secondary">
        <div>Your membership code: <strong>@ViewBag.MembershipCode</strong></div>
        <div>Your username: <strong>@ViewBag.Username</strong> <a class="ms-2" asp-action="Username">Change username</a></div>
    </div>
    <form asp-action="Details" method="post" class="card"><div class="card-body p-4">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" autocomplete="given-name" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" autocomplete="family-name" /><span asp-validation-for="LastName" class="text-danger"></span></div>
            <div class="col-12"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" autocomplete="tel" /><span asp-validation-for="Phone" class="text-danger"></span></div>
            <div class="col-12"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" autocomplete="street-address" /><span asp-validation-for="Address" class="text-danger"></span></div>
        </div>
        <button class="btn btn-primary mt-4" type="submit">Save contact details</button>
    </div></form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
