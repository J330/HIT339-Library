@model Item

@{
    ViewData["Title"] = "Delete Item";
    var hasBorrowingHistory = ViewBag.HasBorrowingHistory is bool value && value;
    var itemType = Model switch
    {
        Book => "Book",
        Music => "Music",
        Toy => "Toy",
        _ => "Item"
    };
}

<h1>Delete Item</h1>

@if (hasBorrowingHistory)
{
    <div class="alert alert-warning">
        <strong>This item cannot be deleted.</strong> It has borrowing history that must be kept for library records and manager statistics. You can edit the item or change its status instead.
    </div>
}
else
{
    <div class="alert alert-danger">
        Are you sure you want to permanently delete this item?
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@itemType</dd>
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Library Code</dt>
            <dd class="col-sm-9">@Model.LibraryCode</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="d-flex gap-2">
    <input type="hidden" asp-for="Id" />
    @if (!hasBorrowingHistory)
    {
        <button type="submit" class="btn btn-danger">Delete Item</button>
    }
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
</form>
