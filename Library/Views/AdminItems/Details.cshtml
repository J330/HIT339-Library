@model Item

@{
    ViewData["Title"] = "Item Details";
    var itemType = Model switch
    {
        Book => "Book",
        Music => "Music",
        Toy => "Toy",
        _ => "Item"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Item Details</h1>
        <p class="text-muted mb-0">Read the full information stored for this library item.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Create New Item</a>
</div>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Item Type</dt>
            <dd class="col-sm-9">@itemType</dd>

            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Library Code</dt>
            <dd class="col-sm-9">@Model.LibraryCode</dd>

            <dt class="col-sm-3">Holding Branch</dt>
            <dd class="col-sm-9">@Model.Branch?.Name</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>

            @if (Model is Book book)
            {
                <dt class="col-sm-3">Author</dt>
                <dd class="col-sm-9">@book.Author</dd>
                <dt class="col-sm-3">Genre</dt>
                <dd class="col-sm-9">@book.Genre</dd>
            }
            else if (Model is Music music)
            {
                <dt class="col-sm-3">Artist</dt>
                <dd class="col-sm-9">@music.Artist</dd>
                <dt class="col-sm-3">Year</dt>
                <dd class="col-sm-9">@music.Year</dd>
                <dt class="col-sm-3">Genre</dt>
                <dd class="col-sm-9">@music.Genre</dd>
            }
            else if (Model is Toy toy)
            {
                <dt class="col-sm-3">Toy Type</dt>
                <dd class="col-sm-9">@toy.Type</dd>
                <dt class="col-sm-3">Minimum Age</dt>
                <dd class="col-sm-9">@toy.MinimumAge</dd>
            }
        </dl>
    </div>
</div>

<div class="d-flex gap-2">
    <a asp-action="Index" class="btn btn-secondary">Back to Items</a>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
</div>
