@model S379658_HIT339_Assignment2_Library.ViewModels.AdminItemViewModel

@{
    ViewData["Title"] = "Create Item";
}

<h1>Create Item</h1>
<p class="text-muted">Add a new book, music item or toy to the library catalogue.</p>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="ItemType" class="form-label"></label>
                <select asp-for="ItemType" class="form-select" id="itemType">
                    <option value="Book">Book</option>
                    <option value="Music">Music</option>
                    <option value="Toy">Toy</option>
                </select>
                <span asp-validation-for="ItemType" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LibraryCode" class="form-label"></label>
                <input asp-for="LibraryCode" class="form-control" />
                <span asp-validation-for="LibraryCode" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="BranchId" class="form-label"></label>
                <select asp-for="BranchId" asp-items="ViewBag.BranchId" class="form-select"><option value="0">-- Select branch --</option></select>
                <span asp-validation-for="BranchId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    <option value="Available">Available</option>
                    <option value="Damaged">Damaged</option>
                    <option value="Destroyed">Destroyed</option>
                </select>
                <div class="form-text">Borrowed status is set automatically by the reception borrowing process.</div>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div id="bookFields" class="item-specific border rounded p-3 mb-3">
                <h5>Book Details</h5>
                <div class="mb-3">
                    <label asp-for="Author" class="form-label"></label>
                    <input asp-for="Author" class="form-control" />
                    <span asp-validation-for="Author" class="text-danger"></span>
                </div>
            </div>

            <div id="musicFields" class="item-specific border rounded p-3 mb-3">
                <h5>Music Details</h5>
                <div class="mb-3">
                    <label asp-for="Artist" class="form-label"></label>
                    <input asp-for="Artist" class="form-control" />
                    <span asp-validation-for="Artist" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Year" class="form-label"></label>
                    <input asp-for="Year" class="form-control" />
                    <span asp-validation-for="Year" class="text-danger"></span>
                </div>
            </div>

            <div id="genreFields" class="mb-3">
                <label asp-for="Genre" class="form-label"></label>
                <input asp-for="Genre" class="form-control" />
                <span asp-validation-for="Genre" class="text-danger"></span>
            </div>

            <div id="toyFields" class="item-specific border rounded p-3 mb-3">
                <h5>Toy Details</h5>
                <div class="mb-3">
                    <label asp-for="ToyType" class="form-label"></label>
                    <input asp-for="ToyType" class="form-control" />
                    <span asp-validation-for="ToyType" class="text-danger"></span>
                </div>
                <div class="mb-0">
                    <label asp-for="MinimumAge" class="form-label"></label>
                    <input asp-for="MinimumAge" class="form-control" />
                    <span asp-validation-for="MinimumAge" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create Item</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        function updateItemFields() {
            const selectedType = document.getElementById('itemType').value;
            document.getElementById('bookFields').style.display = selectedType === 'Book' ? 'block' : 'none';
            document.getElementById('musicFields').style.display = selectedType === 'Music' ? 'block' : 'none';
            document.getElementById('toyFields').style.display = selectedType === 'Toy' ? 'block' : 'none';
            document.getElementById('genreFields').style.display = (selectedType === 'Book' || selectedType === 'Music') ? 'block' : 'none';
        }

        document.getElementById('itemType').addEventListener('change', updateItemFields);
        updateItemFields();
    </script>
}
