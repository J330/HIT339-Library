@model S379658_HIT339_Assignment2_Library.Models.Item
@using S379658_HIT339_Assignment2_Library.Models

@{
    ViewData["Title"] = "Item Details";

    var typeName = Model switch
    {
        Book => "Book",
        Music => "Music",
        Toy => "Toy",
        _ => "Item"
    };

    var statusClass = Model.Status == ItemStatus.Available
        ? "text-bg-success"
        : Model.Status == ItemStatus.Borrowed
            ? "text-bg-warning"
            : "text-bg-secondary";
}

@if (TempData["OnlineBorrowError"] is string onlineBorrowError)
{
    <div class="alert alert-danger" role="alert">@onlineBorrowError</div>
}
<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary">&larr; Back to search</a>
</div>

<div class="card shadow-sm border-0 catalogue-details-card">
    <div class="card-body p-4 p-md-5">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
            <div>
                <span class="badge text-bg-light border mb-2">@typeName</span>
                <h1 class="h2 mb-1">@Model.Name</h1>
                <div class="text-muted">Holding branch: <strong>@Model.Branch?.Name</strong></div>
                <div class="text-muted">Library code: <strong>@Model.LibraryCode</strong></div>
            </div>
            <span class="badge @statusClass fs-6">@Model.Status</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="mb-4">
                <h2 class="h5">Description</h2>
                <p class="mb-0">@Model.Description</p>
            </div>
        }

        <div class="row g-3">
            @if (Model is Book book)
            {
                <div class="col-12 col-sm-6">
                    <div class="catalogue-detail-field">
                        <div class="text-muted small">Author</div>
                        <div class="fw-semibold">@book.Author</div>
                    </div>
                </div>
                <div class="col-12 col-sm-6">
                    <div class="catalogue-detail-field">
                        <div class="text-muted small">Genre</div>
                        <div class="fw-semibold">@book.Genre</div>
                    </div>
                </div>
            }
            else if (Model is Music music)
            {
                <div class="col-12 col-sm-6">
                    <div class="catalogue-detail-field">
                        <div class="text-muted small">Artist</div>
                        <div class="fw-semibold">@music.Artist</div>
                    </div>
                </div>
                <div class="col-6 col-sm-3">
                    <div class="catalogue-detail-field">
                        <div class="text-muted small">Year</div>
                        <div class="fw-semibold">@music.Year</div>
                    </div>
                </div>
                <div class="col-6 col-sm-3">
                    <div class="catalogue-detail-field">
                        <div class="text-muted small">Genre</div>
                        <div class="fw-semibold">@music.Genre</div>
                    </div>
                </div>
            }
            else if (Model is Toy toy)
            {
                <div class="col-12 col-sm-6">
                    <div class="catalogue-detail-field">
                        <div class="text-muted small">Toy type</div>
                        <div class="fw-semibold">@toy.Type</div>
                    </div>
                </div>
                <div class="col-12 col-sm-6">
                    <div class="catalogue-detail-field">
                        <div class="text-muted small">Minimum age</div>
                        <div class="fw-semibold">@toy.MinimumAge</div>
                    </div>
                </div>
            }
        </div>

        <div class="alert @(Model.Status == ItemStatus.Available && ViewBag.IsHeld != true ? "alert-success" : "alert-secondary") mt-4 mb-0">
            @if (Model.Status == ItemStatus.Available && ViewBag.IsHeld != true)
            {
                <strong>Available:</strong>
                <span>This item is currently available in the library.</span>
            }
            else
            {
                <strong>Status:</strong>
                <span>@(ViewBag.IsHeld == true ? "This copy is currently reserved for collection." : "This item is currently " + Model.Status.ToString().ToLowerInvariant() + ".")</span>
            }
        </div>
    </div>
</div>

@if (Model is Book && Model.Status == ItemStatus.Available && ViewBag.IsHeld != true)
{
    @if (User.IsInRole("Borrower"))
    {
        <form asp-action="BorrowOnline" method="post" class="mt-3 d-flex flex-wrap align-items-end gap-2">
            <input type="hidden" name="ItemId" value="@Model.Id" />
            <div>
                <label for="detailLoanDays" class="form-label fw-semibold">How long would you like to borrow it?</label>
                <select class="form-select" name="LoanDays" id="detailLoanDays" required>
                    @for (var days = 1; days <= 14; days++)
                    {
                        <option value="@days" selected="@(days == 14)">@days day@(days == 1 ? "" : "s")</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-success">Borrow this book online</button>
        </form>
        <p class="small text-muted mt-2">Choose 1–14 days. Your loan starts today and is due after the period you select. Collect the physical copy from @Model.Branch?.Name.</p>
    }
    else if (!(User.Identity?.IsAuthenticated ?? false))
    {
        <p class="mt-3"><a asp-controller="Kiosk" asp-action="Login">Sign in as a borrower</a> to borrow this book online.</p>
    }
}

@if (Model.Status == ItemStatus.Borrowed || Model.Status == ItemStatus.Damaged || ViewBag.IsHeld == true) {
    @if (User.IsInRole("Borrower")) {
        <form asp-controller="Reservations" asp-action="Place" method="post" class="mt-3">
            <input type="hidden" name="itemId" value="@Model.Id" />
            <button class="btn btn-primary">Reserve this copy / join waitlist</button>
        </form>
    } else {
        <p class="mt-3"><a asp-controller="Kiosk" asp-action="Login">Sign in as a member</a> to reserve this unavailable copy.</p>
    }
}
