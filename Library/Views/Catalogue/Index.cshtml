@model S379658_HIT339_Assignment2_Library.ViewModels.CatalogueSearchViewModel
@using S379658_HIT339_Assignment2_Library.Models

@{
    ViewData["Title"] = "Search Catalogue";
}

<section class="catalogue-hero mb-4">
    <div>
        <span class="badge text-bg-primary mb-2">Public Catalogue</span>
        <h1 class="display-6 fw-semibold mb-2">Find a library item</h1>
        <p class="lead mb-0">Search the library catalogue from your phone, tablet or computer. No staff login is required.</p>
    </div>
</section>

@if (User.IsInRole("Borrower"))
{
    var overdueCount = Model.MyBorrowedBooks.Count(b => b.DaysRemaining < 0);
    var dueSoonCount = Model.MyBorrowedBooks.Count(b => b.DaysRemaining >= 0 && b.DaysRemaining <= 2);
    <section class="card border-0 shadow-sm catalogue-loans-hud mb-4" aria-labelledby="myLoansTitle">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
                <div>
                    <h2 class="h4 mb-1" id="myLoansTitle">My borrowed books</h2>
                    <p class="text-muted mb-0">Your current book loans and return deadlines.</p>
                </div>
                <a asp-controller="Kiosk" asp-action="Account" class="btn btn-outline-primary">View all my loans</a>
            </div>
            <div class="row g-2 mb-3">
                <div class="col-4"><div class="loan-hud-stat"><strong>@Model.MyBorrowedBooks.Count</strong><span>Borrowed</span></div></div>
                <div class="col-4"><div class="loan-hud-stat"><strong>@dueSoonCount</strong><span>Due within 2 days</span></div></div>
                <div class="col-4"><div class="loan-hud-stat"><strong>@overdueCount</strong><span>Overdue</span></div></div>
            </div>
            @if (Model.MyBorrowedBooks.Count == 0)
            {
                <p class="mb-0">You have no books currently checked out.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-1">
                        <thead><tr><th>Book</th><th>Holding branch</th><th>Return by</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var loan in Model.MyBorrowedBooks.Take(5))
                            {
                                <tr>
                                    <td><a asp-action="Details" asp-route-id="@loan.ItemId">@loan.Title</a></td>
                                    <td>@loan.BranchName</td>
                                    <td>@loan.DueOn.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @if (loan.DaysRemaining < 0)
                                        { <span class="badge text-bg-danger">@(-loan.DaysRemaining) day(s) overdue</span> }
                                        else if (loan.DaysRemaining == 0)
                                        { <span class="badge text-bg-warning">Due today</span> }
                                        else if (loan.DaysRemaining <= 2)
                                        { <span class="badge text-bg-warning">@loan.DaysRemaining day(s) left</span> }
                                        else
                                        { <span class="badge text-bg-success">@loan.DaysRemaining day(s) left</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.MyBorrowedBooks.Count > 5)
                { <p class="small text-muted mb-0">Showing five of @Model.MyBorrowedBooks.Count books. Select “View all my loans” for the full list.</p> }
            }
        </div>
    </section>
}

<div class="card shadow-sm border-0 catalogue-search-card mb-4">
    <div class="card-body p-3 p-md-4">
        <form asp-action="Index" method="get">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-6">
                    <label for="searchString" class="form-label fw-semibold">Search</label>
                    <input id="searchString"
                           name="searchString"
                           value="@Model.SearchString"
                           class="form-control form-control-lg"
                           placeholder="Title, author, artist, genre or code"
                           autocomplete="off" />
                </div>

                <div class="col-6 col-lg-2">
                    <label for="itemType" class="form-label fw-semibold">Item type</label>
                    <select id="itemType" name="itemType" class="form-select form-select-lg">
                        <option value="">All types</option>
                        <option value="Book" selected="@(Model.ItemType == "Book")">Books</option>
                        <option value="Music" selected="@(Model.ItemType == "Music")">Music</option>
                        <option value="Toy" selected="@(Model.ItemType == "Toy")">Toys</option>
                    </select>
                </div>

                <div class="col-6 col-lg-2">
                    <label for="status" class="form-label fw-semibold">Status</label>
                    <select id="status" name="status" class="form-select form-select-lg">
                        <option value="">Any status</option>
                        @foreach (var itemStatus in Enum.GetValues<ItemStatus>())
                        {
                            <option value="@itemStatus" selected="@(Model.Status == itemStatus.ToString())">@itemStatus</option>
                        }
                    </select>
                </div>

                <div class="col-12 col-lg-2 d-grid">
                    <button type="submit" class="btn btn-primary btn-lg">Search</button>
                </div>
                <div class="col-12 col-md-6">
                    <label for="category" class="form-label fw-semibold">Genre or category</label>
                    <input id="category" name="category" value="@Model.Category"
                           class="form-control" placeholder="e.g. Fantasy, Jazz, Puzzle" />
                </div>
                <div class="col-12 col-md-6">
                    <label for="branchId" class="form-label fw-semibold">Library branch</label>
                    <select id="branchId" name="branchId" class="form-select">
                        <option value="">All branches</option>
                        @foreach (var branch in Model.Branches)
                        {
                            <option value="@branch.Id" selected="@(Model.BranchId == branch.Id)">@branch.Name</option>
                        }
                    </select>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.SearchString) ||
                 !string.IsNullOrWhiteSpace(Model.ItemType) ||
                 !string.IsNullOrWhiteSpace(Model.Status) ||
                 !string.IsNullOrWhiteSpace(Model.Category) ||
                 Model.BranchId.HasValue)
            {
                <div class="mt-3">
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear search</a>
                </div>
            }
        </form>
    </div>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="h4 mb-0">Catalogue items</h2>
    <span class="text-muted">@Model.ResultCount result@(Model.ResultCount == 1 ? "" : "s")</span>
</div>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-light border shadow-sm" role="alert">
        <h3 class="h5">No items found</h3>
        <p class="mb-0">Try a different search term or clear one of the filters.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model.Items)
        {
            var typeName = item switch
            {
                Book => "Book",
                Music => "Music",
                Toy => "Toy",
                _ => "Item"
            };

            var held = Model.HeldItemIds.Contains(item.Id);
            var statusClass = item.Status == ItemStatus.Available && !held
                ? "text-bg-success"
                : item.Status == ItemStatus.Borrowed
                    ? "text-bg-warning"
                    : "text-bg-secondary";

            <div class="col-12 col-md-6 col-xl-4">
                <article class="card h-100 shadow-sm catalogue-item-card">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <span class="badge text-bg-light border">@typeName</span>
                            <span class="badge @statusClass">@(held ? "On hold" : item.Status.ToString())</span>
                        </div>

                        <h3 class="h5 card-title mb-1">@item.Name</h3>
                        <div class="small text-muted mb-1">Library code: <strong>@item.LibraryCode</strong></div>
                        <div class="small text-muted mb-3">Branch: @item.Branch?.Name</div>

                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <p class="card-text catalogue-description">@item.Description</p>
                        }

                        <div class="mt-auto pt-2">
                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-primary w-100">
                                View details
                            </a>
                            @if (item is Book && item.Status == ItemStatus.Available && !held && User.IsInRole("Borrower"))
                            {
                                <form asp-action="BorrowOnline" method="post" class="mt-2 d-grid gap-2">
                                    <input type="hidden" name="ItemId" value="@item.Id" />
                                    <label class="form-label mb-0 small fw-semibold" for="loanDays-@item.Id">Borrowing period</label>
                                    <select class="form-select" id="loanDays-@item.Id" name="LoanDays" required>
                                        @for (var days = 1; days <= 14; days++)
                                        {
                                            <option value="@days" selected="@(days == 14)">@days day@(days == 1 ? "" : "s")</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-success w-100">Borrow online</button>
                                </form>
                            }
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
