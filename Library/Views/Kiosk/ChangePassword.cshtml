@model S379658_HIT339_Assignment2_Library.ViewModels.KioskChangePasswordViewModel
@{ Layout = "_Layout"; ViewData["Title"] = "Change password"; }
<div class="kiosk-panel mx-auto">
    <h1>Set your own password</h1>
    <p class="lead">For security, replace the temporary password issued by reception.</p>
    <form asp-action="ChangePassword" method="post" class="d-grid gap-3">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div><label asp-for="CurrentPassword" class="form-label"></label><input asp-for="CurrentPassword" class="form-control form-control-lg" autocomplete="current-password" /><span asp-validation-for="CurrentPassword" class="text-danger"></span></div>
        <div><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control form-control-lg" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="text-danger"></span></div>
        <div><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
        <p>Use at least 8 characters, including an uppercase letter, lowercase letter, number and symbol.</p>
        <button type="submit" class="btn btn-primary btn-lg kiosk-action">Save new password</button>
    </form>
</div>
